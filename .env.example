# Copy to .env and fill in. Never commit .env.

# MQTT broker (Mosquitto on the edge laptop)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
INTERSECTION_ID=int01

# Camera (DroidCam / Iriun shows up as a webcam index: try 0, 1 or 2)
CAMERA_INDEX=1

# MySQL (used by Squad A's ingest and by Squad B's DB validation tests)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=catarman
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=catarman_traffic
